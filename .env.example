# verify: only authenticate callbacks; clip: pull and save messages.
MODE=verify
WECHAT_CORP_ID=
WECHAT_CALLBACK_TOKEN=
WECHAT_ENCODING_AES_KEY=
# Required only in clip mode. Obtain from the independent KF console.
WECHAT_SECRET=
WECHAT_KF_ID=
# Comma-separated external_userid values. Empty means reject ALL senders.
WECHAT_ALLOWED_USERS=
MEMOS_URL=http://host.docker.internal:5230
MEMOS_TOKEN=
# Optional public URL for attachment links; defaults to relative /file/... paths.
MEMOS_PUBLIC_URL=
# Optional CA file path; TLS verification is never disabled.
MEMOS_CA_FILE=
DATA_DIR=./data
POLL_SECONDS=300
MAX_MEDIA_BYTES=20971520

# Added to every clip; comma-separated names without #. May be empty.
DEFAULT_TAGS=微信剪藏
# Always added to merged chat records.
CHAT_RECORD_TAG=微信聊天记录
# explicit: customized Memos tags/explicitTags fields; markdown: upstream-compatible footer.
MEMOS_TAG_MODE=markdown
# One final type-prefixed result, no received/start notification.
RECEIPTS_ENABLED=false
